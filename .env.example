TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=dev-local-key

# Необязательно — без неё db/session.py по умолчанию использует локальный
# SQLite-файл (rpg.db). Для PostgreSQL (запуск процессами на хосте):
DATABASE_URL=postgresql+psycopg2://rpg:rpg@localhost:5432/rpg

# Только для docker-compose (docker-compose.yml собирает DATABASE_URL
# сервиса api из этих трёх переменных сам, с хостом db вместо localhost) —
# те же значения, что выше, просто разложены по отдельности для образа
# postgres:16.
POSTGRES_USER=rpg
POSTGRES_PASSWORD=rpg
POSTGRES_DB=rpg
