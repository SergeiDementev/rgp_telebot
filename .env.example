# Обязательны (docs/hardening_plan.md, этап 2) — без любой из них api/бот
# сразу падают понятной ошибкой при старте, не тихо работают с
# дефолтом/не той БД (db/settings.py, api/settings.py, bot/settings.py).

TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
INTERNAL_API_KEY=dev-local-key

# Необязательно — без неё бот по умолчанию ищет api/ на localhost:8000
# (bot/settings.py); неверный адрес здесь не тихая ошибка, а сразу
# заметный connection error на первом же запросе к API.
API_BASE_URL=http://127.0.0.1:8000

# Для PostgreSQL (запуск процессами на хосте — см. docs/README.md §2):
DATABASE_URL=postgresql+psycopg2://rpg:rpg@localhost:5432/rpg

# Только для docker-compose (docker-compose.yml собирает DATABASE_URL
# сервиса api из этих трёх переменных сам, с хостом db вместо localhost) —
# те же значения, что выше, просто разложены по отдельности для образа
# postgres:16.
POSTGRES_USER=rpg
POSTGRES_PASSWORD=rpg
POSTGRES_DB=rpg

# Только на сервере, для db/backup_db.sh и db/restore_db.sh
# (docs/hardening_plan.md, этап 3) — не секрет, это имя хранилища
# аккаунта Oracle Object Storage, не ключ доступа (сами скрипты
# авторизуются через --auth instance_principal, без ключей на диске).
OCI_NAMESPACE=
